NODE_ENV=development
PORT=3000
INSTANCE_ID=local

# 生产/双节点运行必须配置共享 PostgreSQL + pgvector。
DATABASE_URL=postgres://wealth:wealth@localhost:5432/wealth_demo
DATABASE_SSL=false

# 共享文档目录；双节点部署时将它挂载到同一个共享卷或替换为对象存储适配器。
DOCUMENT_STORE_PATH=./var/documents

# W1 固定使用真实 PostgreSQL；DATA_MODE=fixture 只保留为无库时的本地 UI 旁路。
DATA_MODE=database
# W1：AI_MODE=fixture 使用确定性演示桩，不调用真实模型；生产必须为 real。
# AI_MODE=real 时走真实生成/Embedding API。
AI_MODE=fixture
REQUIRE_MODEL=true

# 兼容 OpenAI 协议的真实生成/Embedding 服务。服务端读取，浏览器永远看不到密钥。
# AI_MODE=fixture 时这四项可全部留空，由 fixtureVector.js 提供确定性默认值。
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
EMBEDDING_MODEL_NAME=
MODEL_TIMEOUT_MS=30000
KNOWLEDGE_VECTOR_DIM=1536

# 仅允许明确的本地开发跨域来源，默认同源。
CORS_ORIGIN=
