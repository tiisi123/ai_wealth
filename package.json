{
  "name": "wealth-prototype-demo",
  "version": "0.1.0",
  "private": true,
  "description": "财富智服演示版：双节点无状态应用服务、共享 PostgreSQL/pgvector 与真实模型 API 的单仓库脚手架",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "import:validate": "node scripts/import/validate.js",
    "import:run": "node scripts/import/run.js",
    "knowledge:index": "node scripts/knowledge/index.js",
    "sync:products": "node scripts/sync/products.js",
    "acceptance": "node scripts/acceptance/checks.js",
    "test": "node --test",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:e2e": "playwright test",
    "check": "node --check src/server.js && node --check src/app.js && npm test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "supertest": "^7.1.1"
  }
}
